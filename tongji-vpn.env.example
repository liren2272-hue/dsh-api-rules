# 同济统一身份认证 —— 供 api-rules 插件自动拨号（openconnect --protocol=array）使用
#
# 用法：把本文件复制成 tongji-vpn.env，然后只填 password 那一行。
#   cp tongji-vpn.env.example tongji-vpn.env
#
# 为什么叫 .example：真文件名 tongji-vpn.env 已被 .gitignore 忽略，
# 因为它会放明文密码；模板本身不含任何凭据，可以入库。
#
# 这是明文文件。用完想清理，删掉 tongji-vpn.env 即可，插件会退回
# 「只提示不通、不自动拨号」的模式。

# 学工号（同济统一身份认证账号，通常 7 位数字）
username=

# 认证方式。Array AG 网关上默认的本地库认证就是这一项，
# 不确定就别改：default_method_localdb
authgroup=default_method_localdb

# 统一身份认证密码。密码里有 = 也不用转义，等号右边整段都是密码。
password=

# 可选：网关地址，默认就是同济的（一般不用填）
# gateway=vpn.tongji.cn
